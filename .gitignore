# data & results are regenerated, never committed -- except the packaged
# real-data tables and the two headline results, which are small and must stay
# bit-identical for the README to be reproducible.
# (git cannot re-include a file whose parent directory is excluded, so the
#  directory patterns are written one level down.)
data/*
!data/.gitkeep
!data/fullbio/
data/fullbio/*
!data/fullbio/features.npz
!data/fullbio/heldout_5ct.npz
results/*
!results/fullbio_loco.json
!results/heldout_transfer.json
!results/publication_suite.json

# python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# notebooks
.ipynb_checkpoints/

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
